[
  {
    "kernelSource": {
      "name": "EvolutionX-KVM",
      "repo": "https://github.com",
      "branch": "lineage-21",
      "device": "gta4xlve"
    },
    "withKernelSU": false,
    "toolchains": [
      {
        "repo": "https://github.com/kdrag0n/proton-clang.git",
        "branch": "master",
        "name": "clang"
      }
    ],
    "params": {
      "ARCH": "arm64",
      "CROSS_COMPILE": "aarch64-linux-gnu-",
      "CROSS_COMPILE_COMPAT": "arm-linux-gnueabi-",
      "CC": "clang"
    },
    "extraParams": {
      "DEFCONFIG": "gta4xlve_defconfig",
      "POST_DEFCONFIG_COMMAND": "echo 'CONFIG_KVM=y' >> arch/arm64/configs/gta4xlve_defconfig && echo 'CONFIG_VIRTUALIZATION=y' >> arch/arm64/configs/gta4xlve_defconfig"
    }
  }
]
